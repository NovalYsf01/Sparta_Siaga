# REQUIRED — runtime only; never pass these as Docker build arguments.
DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>"
JWT_SECRET="<random-secret-at-least-32-characters>"
SPARTA_INTERNAL_WORKER_SECRET="<random-secret-at-least-32-characters>"
PRIVATE_STORAGE_ROOT="/app/storage"

# OPTIONAL — bounded database pool and TLS settings.
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
DATABASE_IDLE_TIMEOUT_MS=30000
DATABASE_SSL_MODE="require"
# Required only when DATABASE_SSL_MODE=verify-full.
DATABASE_SSL_CA_BASE64=""

# OPTIONAL INTEGRATIONS — runtime configuration, required only when the
# corresponding SSO/notification-link integration is used.
APP_BASE_URL="https://example.company.internal"
SPARTA_API_URL="https://sparta-api.example.company.internal"
SPARTA_LOGIN_URL="https://sparta-login.example.company.internal"

# APPLICATION
PORT=3004
NEXT_PUBLIC_APP_NAME="SPARTA Siaga"
TZ="Asia/Jakarta"

# DEVELOPMENT ONLY — do not enable in production.
ALLOW_DEV_FALLBACK_DATA=false
NEXT_PUBLIC_ENABLE_ROLE_SIMULATION=false
ENABLE_AUTONOMOUS_DAEMON_IN_DEV=false
